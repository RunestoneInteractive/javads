          <cell>logical and</cell>
          <cell>
            <c>&amp;&amp;</c>
          </cell>
          <cell>Both operands true for result to be true</cell>
        </row>
        <row>
          <cell>logical or</cell>
          <cell>
            <c>||</c>
          </cell>
          <cell>
            <line>One or the other operand is true for the</line>
            <line>result to be true</line>
          </cell>
        </row>
        <row>
          <cell>logical not</cell>
          <cell>
            <c>!</c>
          </cell>
