<?xml version="1.0"?>
<section xml:id="algorithm-analysis_objectives">
  <title>Objectives</title>
  <p>
    <ul>
      <li>
        <p>To understand why algorithm analysis is important.</p>
      </li>
      <li>
        <p>To be able to use Big O to describe execution time.</p>
      </li>
      <li>
        <p>To understand the Big O execution time of common operations on Kotlin MutableLists and Kotlin MutableMaps.</p>
      </li>
      <li>
        <p>To understand how the implementation of Kotlin data impacts algorithm analysis.</p>
      </li>
      <li>
        <p>To understand how to benchmark simple Kotlin programs.</p>
      </li>
    </ul>
  </p>
</section>
